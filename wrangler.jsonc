{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "day18",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/crossover/api/*", "/day18", "/day18/*"]
  },
  "routes": [
    { "pattern": "build40for40.com/crossover", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/crossover/*", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/day18", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/day18/*", "zone_name": "build40for40.com" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
